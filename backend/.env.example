# Salin menjadi .env lalu isi nilainya.
# Secret JWT: minimal 32 karakter acak, misalnya dari `openssl rand -hex 48`.
MANOTE_JWT_SECRET=
MANOTE_DB_URL=jdbc:postgresql://localhost:1035/manote
MANOTE_DB_USERNAME=manote
MANOTE_DB_PASSWORD=
# Alamat web yang boleh memanggil API, pisahkan dengan koma.
MANOTE_CORS_ALLOWED_ORIGINS=http://localhost:3000
